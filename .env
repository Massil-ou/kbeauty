# kBeauty Configuration

# API
API_BASE_URL=https://api.kbeauty.fr
API_TIMEOUT_SECONDS=30

# Firebase
FIREBASE_PROJECT_ID=kbeauty-prod
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=kbeauty-prod.firebaseapp.com
FIREBASE_DATABASE_URL=https://kbeauty-prod.firebaseio.com
FIREBASE_STORAGE_BUCKET=kbeauty-prod.appspot.com
FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID

# Stripe
STRIPE_PUBLIC_KEY=pk_live_YOUR_KEY
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_KEY

# App
APP_NAME=kBeauty
APP_VERSION=1.0.0
